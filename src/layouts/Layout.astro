---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	robots?: string;
}

const {
	title,
	description = 'Celebramos los 102 años de Elisa con un día inolvidable de música, recuerdos y elegancia.',
	robots = 'index, follow'
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.url).href;
const socialImageUrl = new URL('/images/meta.jpeg', Astro.url).href;
const faviconUrl = new URL('/images/faviconx64.png', Astro.url).href;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="robots" content={robots} />
		<meta name="theme-color" content="#050605" />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="icon" type="image/png" sizes="64x64" href={faviconUrl} />
		<link rel="apple-touch-icon" sizes="64x64" href={faviconUrl} />

		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_AR" />
		<meta property="og:site_name" content={title} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={socialImageUrl} />
		<meta property="og:image:alt" content={title} />
		<meta property="og:image:type" content="image/jpeg" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageUrl} />
		<meta name="twitter:image:alt" content={title} />
		<title>{title}</title>
	</head>
	<body class="bg-ink">
		<slot />
	</body>
</html>
