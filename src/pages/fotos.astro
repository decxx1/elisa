---
import Layout from '@/layouts/Layout.astro';
import PhotoUploader from '@/components/PhotoUploader';
import PublicPhotoGallery from '@/components/PublicPhotoGallery';
import { listPublicPhotos } from '@/lib/db';

const photos = listPublicPhotos();
---

<Layout title="Fotos del festejo · Elisa" description="Compartí y mirá las fotos del festejo de Elisa." robots="noindex, nofollow">
	<main class="relative min-h-screen overflow-hidden bg-ink px-5 py-10 text-ivory sm:px-10 sm:py-14">
		<div class="deco-sunburst pointer-events-none absolute -right-40 -top-24 size-[34rem] opacity-15" aria-hidden="true"></div>
		<div class="relative mx-auto max-w-5xl">
			<header class="flex items-center justify-between gap-5 border-b border-ivory/15 pb-6">
				<a class="font-display text-xl tracking-[.2em] text-ivory sm:text-2xl" href="/">Elisa</a>
				<a class="font-ui text-[10px] font-bold uppercase tracking-[.2em] text-ivory/55 transition hover:text-gold" href="/">Volver al sitio</a>
			</header>

			<section class="border border-gold/35 bg-ivory/[.035] p-5 shadow-[0_28px_80px_rgba(0,0,0,.35)] sm:p-9">
				<h1 class="mt-5 font-display text-6xl leading-[.82] tracking-[-.055em] sm:text-8xl">
					Tu mirada
					<br />
					<span class="text-gold">de la fiesta.</span>
				</h1>
				<p class="mt-7 max-w-2xl font-serif text-2xl leading-tight text-ivory/70 sm:text-2xl">Elegí fotos de tu galería o tomalas en el momento.</p>
				<div class="mt-7 flex gap-3 border-y border-ivory/10 py-4 font-ui text-[9px] uppercase tracking-[.16em] text-ivory/45">
					<span>JPG · PNG · HEIC · WEBP · AVIF</span>
					<span class="text-gold">Hasta 50 MB por foto</span>
				</div>
				<PhotoUploader client:load />
			</section>

			<section class="mt-10 border border-gold/35 bg-ivory/[.035] p-5 sm:p-9">
				<div class="flex flex-col justify-between gap-5 border-b border-ivory/10 pb-5 sm:flex-row sm:items-end">
					<div>
						<p class="eyebrow">Galería compartida</p>
						<h2 class="mt-3 font-display text-5xl leading-none tracking-[-.04em] sm:text-7xl">Lo que vivimos.</h2>
					</div>
					<div class="flex flex-wrap items-center gap-x-4 gap-y-3 font-ui text-[10px] font-bold uppercase tracking-[.16em]">
						<a class="text-gold transition hover:text-ivory" href="/fotos">Actualizar galería</a>
						{photos.length > 0 && (
							<a class="inline-flex items-center gap-2 border-l border-ivory/20 pl-4 text-ivory/65 transition hover:text-gold" href="/api/photos/download-all">
								Descargar todo
							</a>
						)}
					</div>
				</div>

				{photos.length === 0 ? (
					<p class="py-12 text-center font-ui text-sm text-ivory/50">Todavía no hay fotos compartidas. Sé el primero en subir una.</p>
				) : (
					<PublicPhotoGallery photos={photos} client:load />
				)}
			</section>
		</div>
	</main>
</Layout>
